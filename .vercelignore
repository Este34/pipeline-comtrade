# Vercel remplace .gitignore par ce fichier quand il existe. Il aligne le
# déploiement CLI (`vercel deploy`) sur le déploiement Git : les fichiers
# volumineux ne partent jamais en sources, ils sont récupérés par deploy/build.sh.
.env
data/
dist/
venv/
__pycache__/
*.pyc
scraper.log
webapp/data/parquet/
webapp/vendor/duckdb-wasm/*.wasm
webapp/vendor/duckdb-wasm/extensions/
