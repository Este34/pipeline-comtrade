.env
# Données brutes et bases (racine), jamais commitées
/data/
scraper.log
venv/
__pycache__/
*.pyc

# Webapp : exclure les gros binaires, garder le code + libellés FR
# Parquet volumineux (jonction/copie vers /data/parquet en dev, copie au déploiement)
webapp/data/parquet/
# Binaires WASM DuckDB (~35 Mo) et extension parquet (~2,8 Mo) : re-téléchargeables,
# voir webapp/vendor/duckdb-wasm/README.md
webapp/vendor/duckdb-wasm/*.wasm
webapp/vendor/duckdb-wasm/extensions/
